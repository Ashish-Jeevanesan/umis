# =========================================================================
# PO Processor - Environment Configuration Template
# =========================================================================

# Server Configuration
SERVER_PORT=8085

# PostgreSQL / Supabase Configuration
# Note: Connect directly to the Supabase PostgreSQL database using JDBC.
# PO Processor operates in its own isolated schema (po_processor).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/umis_db
SPRING_DATASOURCE_USERNAME=umis_user
SPRING_DATASOURCE_PASSWORD=your_database_password_here

# RabbitMQ Configuration
# Connects to the same RabbitMQ broker as UMIS.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# PO Processor Messaging Settings
PO_RABBITMQ_EXCHANGE=umis.events
PO_RABBITMQ_QUEUE=po-processor.queue.email-ingested
PO_RABBITMQ_ROUTING_KEY=umis.events.email.ingested
PO_RABBITMQ_DLX_EXCHANGE=umis.dlx
PO_RABBITMQ_DLQ_QUEUE=po-processor.queue.dlq
PO_RABBITMQ_DLQ_ROUTING_KEY=po-processor.dlq
PO_RABBITMQ_PREFETCH=5
PO_RABBITMQ_MAX_RETRIES=3

# UMIS Storage Access (Read-Only)
# For local development, set to the physical directory where UMIS stores files.
PO_STORAGE_TYPE=LOCAL
PO_STORAGE_LOCAL_BASE_PATH=../backend/storage

# UMIS API & Acknowledgement Client Settings
UMIS_BASE_URL=http://localhost:8080
UMIS_CONSUMER_ID=PO_PROCESSING
# Optional service credentials to authenticate with UMIS and obtain JWT bearer token
UMIS_AUTH_EMAIL=admin@umis.local
UMIS_AUTH_PASSWORD=your_umis_admin_password
