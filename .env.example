# Universal Mailbox Integration Service (UMIS)
# Environment Configuration Template

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL
# POSTGRES_* below configure Docker Compose's own postgres container (docker/docker-compose.yml
# hardcodes the backend's connection to it directly and ignores SPRING_DATASOURCE_URL here).
#
# SPRING_DATASOURCE_URL/_USERNAME/_PASSWORD below are what start-services.ps1 (the local,
# non-Docker launcher) forwards to the backend's 'dev' profile - set these to point local
# development at an external Postgres instead of the embedded H2 file db, e.g. a Supabase
# project: get the connection string, username, and password from
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI / Session pooler).
POSTGRES_DB=umis_db
POSTGRES_USER=umis_user
POSTGRES_PASSWORD=umis_password
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://<your-pooler-or-direct-host>:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672

# Object Storage
# UMIS_STORAGE_TYPE selects the backend: LOCAL (default, zero-config - email bodies and
# attachments are written as plain files under UMIS_STORAGE_LOCAL_BASE_PATH) or S3
# (MinIO/AWS S3, using the UMIS_STORAGE_*/MINIO_* settings below). Existing S3 objects stay
# exactly where they are when you switch types back and forth - switching never moves or
# reinterprets data; see docs/STORAGE-ABSTRACTION.md for how to migrate objects between the two.
UMIS_STORAGE_TYPE=LOCAL
# Only used when UMIS_STORAGE_TYPE=LOCAL. Defaults to ./storage (relative to the backend's
# working directory) if unset. Example for a dedicated Windows data drive:
# UMIS_STORAGE_LOCAL_BASE_PATH=D:/UMIS-Data/emails
UMIS_STORAGE_LOCAL_BASE_PATH=

# Only used when UMIS_STORAGE_TYPE=S3 (Docker Compose's own MinIO container, or a real AWS
# S3 bucket/region/credentials for production).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
UMIS_STORAGE_ENDPOINT=http://minio:9000
UMIS_STORAGE_BUCKET=umis-emails

# Security & Encryption
UMIS_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
UMIS_ENCRYPTION_KEY=umis-secret-key-for-credentials

# Microsoft 365 OAuth Credentials (Optional for local Mock mode)
# The OAuth redirect lands back on the frontend SPA (not a backend endpoint) -
# register this exact URL as the app's Web Redirect URI in Azure AD.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=http://localhost:3000/

# Google Workspace / Gmail OAuth Credentials (Optional for local Mock mode)
# The OAuth redirect lands back on the frontend SPA (not a backend endpoint) -
# register this exact URL as an Authorized redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/

# Frontend
VITE_API_BASE_URL=http://localhost:8080
